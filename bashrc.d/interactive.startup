#             (~/.bashrc.d/interactive.startup)
# =============================================

# --------------------
# Default
# --------------------

# --- Shopts ---
if type shopt >/dev/null 2>&1; then
    if shopt -q pushd_ignore_dups 2>/dev/null; then
        shopt -s pushd_ignore_dups  # 目录栈去重
    fi
    if shopt -q autopushd 2>/dev/null; then
        shopt -s autopushd        # cd 自动将旧目录推入目录栈
    fi
    shopt -s extglob    # 反向通配，如 rm -rf !(*.txt) 删除除 .txt 外的所有文件；ls *.!(sh|py) ：显示非 .sh/.py 文件
    if shopt -q autocd 2>/dev/null && shopt -q cdspell 2>/dev/null && shopt -q dirspell 2>/dev/null; then
        shopt -s autocd cdspell dirspell #checkwinsize  # 输入目录名进入，自动修正拼写错误的目录名，自动切换到目录，检查窗口大小变化
    fi
fi
# --------------

# --- History Settings ---
shopt -s histappend
HISTFILE="$HOME/.bash_history"
HISTCONTROL=ignoreboth
HISTIGNORE='&:[ ]*'
HISTSIZE=10000
HISTFILESIZE=10000

# Capture $? and PIPESTATUS as arguments BEFORE any assignment clobbers them,
# then build the prompt. (A plain `_saved_ec=$?; _saved_ps=("${PIPESTATUS[@]}")`
# would reset PIPESTATUS on the first assignment, losing the pipeline status.)
__prompt_pre() {
    _saved_ec=$1
    _saved_ps=("${@:2}")
    history -a
    history -n
    _build_prompt
}
PROMPT_COMMAND='__prompt_pre "$?" "${PIPESTATUS[@]}"'
bind -x '"\C-p": __prompt_toggle_style'
# ------------------------

# Custom cd function to support numeric directory-stack navigation with pushd,
# while preserving normal cd behavior for regular paths.
cd() {
    if [[ $# -eq 1 && "$1" =~ ^[+-][0-9]+$ ]]; then
        builtin pushd "$1" >/dev/null 2>&1
        return
    fi

    local oldpwd="$PWD"
    if builtin cd "$@"; then
        local newpwd="$PWD"
        if [[ "$oldpwd" != "$newpwd" ]]; then
            if ! shopt -q autopushd 2>/dev/null; then
                builtin pushd -n "$oldpwd" >/dev/null 2>&1 || true
            fi
        fi
        return 0
    fi
    return 1
}

# Welcome message
printf "Welcome to Bash, \033[0;32m%s\033[0m! \n" "$USER"



# ---------------------------------
#  _    _         _
# | |__(_)_ _  __| |
# | '_ \ | ' \/ _` |
# |_.__/_|_||_\__,_|
# (~/.bashrc.d/interactive.startup)
# ---------------------------------

# 绑定 Alt+↑ 进行子串搜索（向后搜索）
bind '"\e[1;3A": history-substring-search-backward'
# 绑定 Alt+↓ 进行子串搜索（向前搜索）
bind '"\e[1;3B": history-substring-search-forward'

# --------------------
# Tab 补全优化
# --------------------
bind 'TAB:menu-complete'
bind '"\e[Z": menu-complete-backward'   # Shift+Tab 反向轮询

# 跳过已输入的重叠文本（避免出现 "foo/foo/" 这种冗余）
bind 'set skip-completed-text on'
# 补全列表着色并显示类型标识（目录带 /，可执行文件带 *）
bind 'set colored-stats on'
bind 'set visible-stats on'
# 补全不区分大小写（输入 ream 能匹配 ReadMe）
bind 'set completion-ignore-case on'
# 显示全部候选并保留已输入前缀
bind 'set show-all-if-ambiguous on'
bind 'set menu-complete-display-prefix on'
# 目录符号链接自动添加斜杠
bind 'set mark-symlinked-directories on'
# 不自动补全隐藏文件，除非输入了 "."
bind 'set match-hidden-files off'
# 水平滚动模式（避免长命令换行）
#bind 'set horizontal-scroll-mode on'
